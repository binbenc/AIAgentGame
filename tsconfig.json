{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "node"],
    "paths": { "agent-quest": ["./src/engine/runtime/api.ts"] }
  },
  "include": ["src", "tests", "vite.config.ts"],
  "exclude": [
    "src/content/levels/*/starter/**", "src/content/levels/*/solution/**", "src/content/levels/*/starter.en/**", "src/content/levels/*/solution.en/**",
    "src/projects/*/starter/**", "src/projects/*/solution/**", "src/projects/*/starter.en/**", "src/projects/*/solution.en/**",
    "src/export/template/**", "src/export/template.en/**"
  ]
}
