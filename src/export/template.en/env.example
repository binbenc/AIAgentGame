# Real model config (used by npm run agent / npm run test:real)
# anthropic or openai (any OpenAI-compatible API: DeepSeek, Qwen, Kimi, Ollama, ...)
LLM_PROVIDER=anthropic
LLM_API_KEY=
# Required for OpenAI-compatible APIs, e.g. https://api.deepseek.com/v1
LLM_BASE_URL=
# Model tier mapping
LLM_MODEL_DEFAULT=claude-opus-5-5
LLM_MODEL_FAST=claude-haiku-4-5
